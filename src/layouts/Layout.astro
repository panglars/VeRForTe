---
import Header from "@/components/core/Header";
import Footer from "@/components/core/Footer.astro";
import { getLangFromUrl } from "../i18n/utils";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/open-sans";
import { siteConfig } from "@/config/site";

export interface Props {
  title: string;
}

const lang = getLangFromUrl(Astro.url);
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title}`} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (() => {
        const resolveTheme = () => {
          const hashMatch = window.location.hash.match(/theme=([^&]+)/);
          if (hashMatch) {
            try {
              return decodeURIComponent(hashMatch[1]);
            } catch {
              return hashMatch[1];
            }
          }
          try {
            const stored = window.localStorage.getItem("theme");
            if (!stored) return "system";
            try {
              return JSON.parse(stored);
            } catch {
              return stored;
            }
          } catch {
            return "system";
          }
        };

        const applyTheme = () => {
          const theme = resolveTheme();
          const isDark =
            theme === "dark" ||
            ((theme === "system" || !theme) &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", isDark);
        };

        applyTheme();
        if (!window.__verforteThemeBound) {
          window.__verforteThemeBound = true;
          document.addEventListener("astro:after-swap", applyTheme);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground font-sans">
    <Header
      client:load
      siteConfig={siteConfig}
      navigation={[
        { label: "nav.table", href: "/table/" },
        { label: "nav.list", href: "/reports/" },
      ]}
      externalLinks={[
        { label: "nav.ruyi", href: "https://ruyisdk.org" },
        { label: "nav.ruyi_community", href: "https://ruyisdk.cn" },
      ]}
      currentPath={currentPath}
      lang={lang}
    />
    <main class="flex-1 w-full mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
