---
import Layout from "@/layouts/Layout.astro";
import Overview from "@/components/home/Overview";
import { siteConfig } from "@/config/site";
import { getHomePageData } from "@/lib/home-data";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { boards, systems, stats } = await getHomePageData();

const subtitle = t("home.subtitle")
  .replace("{boards}", stats.totalBoards.toString())
  .replace("{systems}", stats.totalSystems.toString())
  .replace("{reports}", stats.totalReports.toString());
---

<Layout title={siteConfig.title}>
  <div class="max-w-5xl mx-auto">
    <h1 class="text-center text-3xl sm:text-4xl font-bold tracking-tight mt-6 mb-3">
      {siteConfig.title}
    </h1>
    <p class="text-center text-sm sm:text-base text-muted-foreground mb-2">
      {subtitle}
    </p>
    <Overview client:load boards={boards} systems={systems} lang={lang} />
  </div>
</Layout>
