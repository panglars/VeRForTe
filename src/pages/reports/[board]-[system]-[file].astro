---
import Layout from "@/layouts/Layout.astro";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import { getSiteData } from "@/lib/data";

const reportMarkdownFiles = import.meta.glob("/support-matrix/**/*.md");

export async function getStaticPaths() {
  const siteData = await getSiteData();

  const paths = [];

  for (const system of siteData.systems.values()) {
    for (const report of system.reports) {
      if (report.sourceType !== "report" || !report.fileName) continue;

      paths.push({
        params: {
          board: report.boardId,
          system: report.systemDir,
          file: report.fileName,
        },
      });
    }
  }

  return paths;
}

const params = Astro.params;
const siteData = await getSiteData();

interface PageState {
  boardName: string | null;
  systemDir: string | null;
  systemName: string | null;
  report: {
    version: string | null;
    variant: string | null;
    status: string;
    lastUpdate: Date | null;
  } | null;
  error: string | null;
  content: any;
}

async function loadPageState(): Promise<PageState> {
  const boardId = params.board;
  const systemDir = params.system;
  const fileName = params.file;

  if (!boardId || !systemDir || !fileName) {
    return {
      boardName: null,
      systemDir: null,
      systemName: null,
      report: null,
      error: "Missing report identifier",
      content: null,
    };
  }

  const board = siteData.boards.get(boardId);
  const system = siteData.systems.get(systemDir);

  if (!board) {
    return {
      boardName: null,
      systemDir: systemDir,
      systemName: system?.name ?? systemDir,
      report: null,
      error: `Board information for "${boardId}" not found`,
      content: null,
    };
  }

  if (!system) {
    return {
      boardName: board.meta.product,
      systemDir: systemDir,
      systemName: systemDir,
      report: null,
      error: `System information for "${systemDir}" not found`,
      content: null,
    };
  }

  const report = system.reports.find(
    (item) => item.boardId === boardId && item.fileName === fileName,
  );

  if (!report || report.sourceType !== "report") {
    return {
      boardName: board.meta.product,
      systemDir: systemDir,
      systemName: system.name,
      report: null,
      error: `Report "${fileName}" not found for ${system.name}`,
      content: null,
    };
  }

  const markdownPath = `/support-matrix/${boardId}/${systemDir}/${fileName}.md`;

  if (!reportMarkdownFiles[markdownPath]) {
    return {
      boardName: board.meta.product,
      systemDir: systemDir,
      systemName: system.name,
      report: null,
      error: `System README file not found: ${markdownPath}`,
      content: null,
    };
  }

  const module = await reportMarkdownFiles[markdownPath]();
  const Content = (module as any).Content;

  return {
    boardName: board.meta.product,
    systemDir: systemDir,
    systemName: system.name,
    report: {
      version: report.sys_ver || null,
      variant: report.sys_var || null,
      status: report.status,
      lastUpdate: report.last_update || null,
    },
    error: null,
    content: Content,
  };
}

const pageState = await loadPageState();
const title =
  pageState.boardName && pageState.systemName
    ? `${pageState.systemName} on ${pageState.boardName} Test Report`
    : "System Not Found";
---

<Layout title={title}>
  <div class="max-w-5xl mx-auto">
    {
      pageState.error ? (
        <div class="p-6 border border-red-300 bg-red-50 text-red-700 rounded-md">
          <h1 class="text-2xl	font-bold mb-4">Error</h1>
          <p>{pageState.error}</p>
        </div>
      ) : (
        <>
          <Card className="mb-8">
            <CardHeader>
              <CardTitle className="text-2xl">
                {pageState.systemName} @ {pageState.boardName} Test Report
              </CardTitle>
            </CardHeader>
            <CardContent>
              <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                  <div>
                    <h3 class="text-sm font-medium text-muted-foreground">
                      System Version
                    </h3>
                    <p class="text-lg">{pageState.report?.version ?? "-"}</p>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-muted-foreground">
                      Status
                    </h3>
                    <p class="text-lg">{pageState.report?.status ?? "-"}</p>
                  </div>
                  {pageState.report?.variant && (
                    <div>
                      <h3 class="text-sm font-medium text-muted-foreground">
                        System Variant
                      </h3>
                      <p class="text-lg">{pageState.report?.variant}</p>
                    </div>
                  )}
                  <div>
                    <h3 class="text-sm font-medium text-muted-foreground">
                      Last Update
                    </h3>
                    <p class="text-lg">
                      {pageState.report?.lastUpdate
                        ? pageState.report.lastUpdate.toLocaleDateString()
                        : "-"}
                    </p>
                  </div>
                </div>
                <div
                  class="prose prose-slate prose-h1:hidden dark:prose-invert max-w-none 
            prose-pre:whitespace-pre-wrap prose-pre:word-break-normal prose-pre:break-words
            prose-a:break-words prose-a:overflow-wrap-anywhere prose-a:word-break-all"
                >
                  {pageState.content ? (
                    <pageState.content />
                  ) : (
                    <p>No detailed information available for this system.</p>
                  )}
                </div>
              </div>
            </CardContent>
          </Card>

          <div class="mt-8">
            <p class="text-sm text-muted-foreground">
              Source:
              <a
                href={`https://github.com/ruyisdk/support-matrix/blob/main/${params.board}/${params.system}/${params.file}.md`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline"
              >
                Support Matrix
              </a>
            </p>
          </div>
        </>
      )
    }
  </div>
</Layout>
