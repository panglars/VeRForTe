---
import Layout from "@/layouts/Layout.astro";
import { Card } from "@/components/ui/card";
import BoardsList from "@/components/details/BoardsList.astro";
import { getSiteData } from "@/lib/data";
import {
  getSystemDetailData,
  STATUS_BAR_COLOR,
  STATUS_ORDER,
} from "@/lib/detail-data";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { statusClassMap } from "@/config/site";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ArrowLeft, ArrowUpRight } from "lucide-react";

export async function getStaticPaths() {
  const siteData = await getSiteData();

  return Array.from(siteData.systems.values()).map((system) => ({
    params: { system: system.id },
  }));
}

const systemId = Astro.params.system;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  system,
  category,
  boards,
  otherEntries,
  totalBoards,
  totalReports,
  statusCounts,
} = await getSystemDetailData(systemId);

const error = !systemId
  ? "缺少系统标识"
  : !system
    ? `未找到系统 ${systemId} 的信息`
    : null;

const systemName = system?.name ?? systemId ?? "System";

const statusEntries = STATUS_ORDER.map((status) => ({
  status,
  count: statusCounts[status] || 0,
})).filter((item) => item.count > 0);

const totalStatuses = statusEntries.reduce((sum, item) => sum + item.count, 0);

const getCategoryLabel = (cat: string) => {
  if (cat === "customized") {
    return t("category.customized");
  }
  return t(cat) || cat;
};
---

<Layout title={`${systemName} 支持矩阵`}>
  <div class="max-w-5xl mx-auto">
    <div class="mb-4 flex items-center justify-between">
      <a
        href={getRelativeLocaleUrl(lang, "", { normalizeLocale: false })}
        class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-primary transition-colors"
      >
        <ArrowLeft className="h-4 w-4" />
        <span>{t("detail.back_home")}</span>
      </a>
    </div>

    {
      error ? (
        <div class="p-6 border border-destructive/40 bg-destructive/10 text-destructive rounded-xl">
          <h1 class="text-2xl font-bold mb-2">{t("error")}</h1>
          <p>{error}</p>
        </div>
      ) : (
        <>
          <Card className="mb-8 border-border/80 bg-card flex flex-col gap-0 py-0 overflow-hidden rounded-xl">
            <div class="p-6 pb-4 space-y-2">
              <div class="flex items-center justify-between gap-3 min-h-6">
                <span class="inline-flex items-center rounded-md bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                  {getCategoryLabel(category)}
                </span>
                <span class="font-mono text-xs text-muted-foreground">
                  {system!.id}
                </span>
              </div>
              <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-card-foreground">
                {systemName}
              </h1>
            </div>

            {totalStatuses > 0 && (
              <div class="px-6 py-4 space-y-3">
                <div class="h-2 w-full rounded-full overflow-hidden flex bg-muted">
                  {statusEntries.map(({ status, count }) => (
                    <div
                      class={STATUS_BAR_COLOR[status]}
                      style={`width: ${(count / totalStatuses) * 100}%`}
                    />
                  ))}
                </div>
                <div class="flex flex-wrap gap-1.5">
                  {statusEntries.map(({ status, count }) => (
                    <span
                      class={`inline-flex items-center rounded px-2 py-0.5 text-xs font-semibold leading-none ${statusClassMap[status] ?? statusClassMap.UNKNOWN}`}
                    >
                      {status} {count}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <div class="px-6 py-3.5 border-t border-border/60 bg-muted/30 flex flex-wrap items-center justify-between gap-3 text-xs text-muted-foreground">
              <span>
                {totalBoards} {t("card.boards")} · {totalReports}{" "}
                {t("card.reports")}
              </span>
            </div>
          </Card>

          {(boards.length > 0 || otherEntries.length === 0) && (
            <BoardsList systemId={systemId!} boards={boards} />
          )}

          {otherEntries.length > 0 && (
            <Card className="mt-8 border-border/80 bg-card flex flex-col gap-0 py-0 overflow-hidden rounded-xl">
              <div class="p-5 pb-3 border-b border-border/60 bg-muted/20">
                <h2 class="text-base font-semibold text-card-foreground">
                  {t("detail.other_boards")}
                </h2>
              </div>
              <div class="p-5">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                  {otherEntries.map((entry) => {
                    const statusClass =
                      statusClassMap[entry.status] ?? statusClassMap.UNKNOWN;
                    return (
                      <a
                        href={getRelativeLocaleUrl(
                          lang,
                          `boards/${entry.boardId}`,
                          { normalizeLocale: false },
                        )}
                        class="group flex items-start justify-between gap-3 rounded-lg border border-border/70 bg-muted/15 p-3.5 hover:border-primary/40 hover:bg-accent/50 transition-all"
                      >
                        <div class="min-w-0 space-y-1.5">
                          <div class="flex items-center gap-1.5">
                            <span class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground truncate">
                              {entry.vendor}
                            </span>
                            {entry.isRuyiSupported && (
                              <img
                                src="/favicon.svg"
                                alt={t("card.ruyi_badge")}
                                title={t("card.ruyi_tooltip")}
                                class="h-3.5 w-3.5 shrink-0"
                              />
                            )}
                          </div>
                          <p class="text-sm font-semibold text-foreground group-hover:text-primary transition-colors flex items-center gap-1 truncate">
                            <span class="truncate">{entry.boardName}</span>
                            <ArrowUpRight className="h-3.5 w-3.5 text-muted-foreground/60 shrink-0 group-hover:text-primary transition-colors" />
                          </p>
                          {(entry.version || entry.variant) && (
                            <p class="text-xs text-muted-foreground">
                              {[entry.version, entry.variant]
                                .filter(Boolean)
                                .join(" · ")}
                            </p>
                          )}
                          {entry.provider && (
                            <p class="text-xs text-muted-foreground">
                              {t("table.provider")}: {entry.provider}
                            </p>
                          )}
                        </div>
                        <span
                          class={`inline-flex items-center rounded px-1.5 py-0.5 text-[11px] font-semibold leading-none shrink-0 ${statusClass}`}
                        >
                          {entry.status}
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </Card>
          )}
        </>
      )
    }
  </div>
</Layout>
