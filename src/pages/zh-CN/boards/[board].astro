---
import Layout from "@/layouts/Layout.astro";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card";
import SystemsList from "@/components/details/SystemsList.astro";
import type { BoardSystemSummary } from "@/components/details/types";
import type { Board } from "@/lib/data";
import { getSiteData } from "@/lib/data";

interface BoardPageData {
  board: Board | null;
  systems: BoardSystemSummary[];
  error: string | null;
}

// Generate static paths for all boards
export async function getStaticPaths() {
  const siteData = await getSiteData();

  return Array.from(siteData.boards.values()).map((board) => ({
    params: { board: board.id },
  }));
}

const boardId = Astro.params.board;
const siteData = await getSiteData();

function buildBoardPageData(boardId: string | undefined): BoardPageData {
  if (!boardId) {
    return { board: null, systems: [], error: "缺少开发板参数" };
  }

  const board = siteData.boards.get(boardId) ?? null;
  if (!board) {
    return {
      board: null,
      systems: [],
      error: `未找到开发板 ${boardId} 的信息`,
    };
  }

  const systems: BoardSystemSummary[] = Array.from(board.systems.entries())
    .map(([systemId, reports]) => {
      const validReports = reports.filter(
        (report) => report.sourceType === "report" && report.fileName,
      );

      if (validReports.length === 0) {
        return null;
      }

      const normalizedReports = validReports
        .map((report) => ({
          id: `${systemId}-${report.fileName}`,
          status: report.status,
          version: report.sys_ver || null,
          variant: report.sys_var || null,
          lastUpdate: report.last_update || null,
          fileName: report.fileName!,
          systemDir: report.systemDir || systemId,
        }))
        .sort((a, b) => {
          const timeA = a.lastUpdate ? a.lastUpdate.getTime() : 0;
          const timeB = b.lastUpdate ? b.lastUpdate.getTime() : 0;
          return timeB - timeA;
        });

      return {
        systemId,
        systemName: siteData.systems.get(systemId)?.name || systemId,
        reports: normalizedReports,
      };
    })
    .filter((system): system is BoardSystemSummary => Boolean(system))
    .sort((a, b) => a.systemName.localeCompare(b.systemName));

  return { board, systems, error: null };
}

const { board, systems, error } = buildBoardPageData(boardId);
const boardMeta = board?.meta;
const pageTitle = boardMeta?.product ?? "Board Not Found";
---

<Layout title={pageTitle}>
  <div class="mx-auto">
    {
      error ? (
        <div class="p-6 border border-red-300 bg-red-50 text-red-700 rounded-md">
          <h1 class="text-2xl font-bold mb-4">错误</h1>
          <p>{error}</p>
        </div>
      ) : (
        <>
          <Card className="mb-8">
            <CardHeader>
              <CardTitle className="text-2xl">{boardMeta!.product}</CardTitle>
            </CardHeader>
            <CardContent>
              <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div>
                    <h3 class="text-sm font-medium text-muted-foreground">
                      处理器
                    </h3>
                    <p class="text-lg">{boardMeta!.cpu}</p>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-muted-foreground">
                      内存
                    </h3>
                    <p class="text-lg">{boardMeta!.ram}</p>
                  </div>
                  <div>
                    <h3 class="text-sm font-medium text-muted-foreground">
                      核心
                    </h3>
                    <p class="text-lg">{boardMeta!.cpu_core}</p>
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>

          <SystemsList boardId={boardId!} systems={systems} />

          <div class="mt-8">
            <p class="text-sm text-muted-foreground">
              来源:
              <a
                href={`https://github.com/ruyisdk/support-matrix/blob/main/${boardId}/README_zh.md`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline"
              >
                支持矩阵
              </a>
            </p>
          </div>
        </>
      )
    }
  </div>
</Layout>
