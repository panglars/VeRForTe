---
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getSupportMatrixData } from "@/lib/table-data";
import SupportMatrix from "@/components/table/SupportMatrix";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { boards, systems, matrix, categories } = await getSupportMatrixData();
---

<Layout title={t("table.title")}>
  <div class="container mx-auto">
    <SupportMatrix
      client:load
      lang={lang}
      boards={boards}
      systems={systems}
      matrix={matrix}
      categories={categories}
    />
  </div>
</Layout>
