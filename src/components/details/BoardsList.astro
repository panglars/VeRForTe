---
import { Card } from "@/components/ui/card";
import { statusClassMap } from "@/config/site";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { pickBestStatus } from "@/lib/detail-data";
import { ArrowUpRight, Calendar, Cpu, MemoryStick } from "lucide-react";
import type { SystemBoardSummary } from "./types";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const dateLocale = lang === "zh-CN" ? "zh-CN" : "en-US";

interface Props {
  systemId: string;
  boards?: SystemBoardSummary[];
}

const { boards = [] }: Props = Astro.props;

const formatDate = (value: Date | null) =>
  value ? value.toLocaleDateString(dateLocale) : "-";
---

{
  boards.length === 0 ? (
    <div class="rounded-xl border border-border/80 bg-card text-center py-12">
      <p class="text-lg text-muted-foreground">
        {t("no_results") ?? "No results found"}
      </p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {boards.map((board) => {
        const boardUrl = getRelativeLocaleUrl(lang, `boards/${board.boardId}`, {
          normalizeLocale: false,
        });
        const bestStatus = pickBestStatus(board.reports.map((r) => r.status));
        const bestStatusClass = bestStatus
          ? statusClassMap[bestStatus] ?? statusClassMap.UNKNOWN
          : null;

        return (
          <Card className="h-full flex flex-col justify-between gap-0 py-0 overflow-hidden rounded-xl border-border/80 bg-card">
            <div class="flex-1 flex flex-col">
              <div class="p-5 pb-3 space-y-2">
                <div class="flex items-center justify-between gap-2 min-h-5">
                  <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground truncate">
                    {board.vendor}
                  </span>
                  {board.isRuyiSupported && (
                    <span
                      title={t("card.ruyi_tooltip")}
                      class="inline-flex items-center gap-1 rounded-full border border-primary/20 bg-secondary/25 dark:bg-primary/15 px-2 py-0.5 text-[11px] font-medium text-primary shrink-0"
                    >
                      <img src="/favicon.svg" alt="" class="h-3.5 w-3.5" />
                      {t("card.ruyi_badge")}
                    </span>
                  )}
                </div>

                <a
                  href={boardUrl}
                  class="group/title flex items-start justify-between gap-2 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >
                  <h2 class="text-base font-semibold leading-snug text-card-foreground group-hover/title:text-primary transition-colors">
                    {board.boardName}
                  </h2>
                  <ArrowUpRight className="h-4 w-4 text-muted-foreground/60 shrink-0 mt-0.5 transition-transform duration-200 group-hover/title:text-primary group-hover/title:translate-x-0.5 group-hover/title:-translate-y-0.5" />
                </a>

                {(board.cpu || board.ram) && (
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground pt-0.5">
                    {board.cpu && (
                      <span class="inline-flex items-center gap-1">
                        <Cpu className="h-3.5 w-3.5 shrink-0" />
                        <span>{board.cpu}</span>
                      </span>
                    )}
                    {board.ram && (
                      <span class="inline-flex items-center gap-1">
                        <MemoryStick className="h-3.5 w-3.5 shrink-0" />
                        <span>{board.ram}</span>
                      </span>
                    )}
                  </div>
                )}
              </div>

              <div class="px-5 py-3 flex-1 space-y-2.5">
                {board.reports.map((report) => {
                  const statusClass =
                    statusClassMap[report.status] ?? statusClassMap.UNKNOWN;
                  return (
                    <a
                      href={getRelativeLocaleUrl(
                        lang,
                        `reports/${board.boardId}-${report.systemDir}-${report.fileName}`,
                        { normalizeLocale: false },
                      )}
                      class="group/report block rounded-lg border border-border/70 bg-muted/15 px-3.5 py-2.5 transition-all hover:border-primary/40 hover:bg-accent/50"
                    >
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                          <p class="text-sm font-medium text-foreground group-hover/report:text-primary transition-colors">
                            {report.version || t("table.default_version")}
                          </p>
                          {report.variant && (
                            <p class="text-xs text-muted-foreground mt-0.5">
                              {t("sys.variant")}: {report.variant}
                            </p>
                          )}
                        </div>
                        <span
                          class={`inline-flex items-center rounded px-1.5 py-0.5 text-[11px] font-semibold leading-none shrink-0 ${statusClass}`}
                        >
                          {report.status}
                        </span>
                      </div>
                      <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
                        <span class="inline-flex items-center gap-1.5">
                          <Calendar className="h-3 w-3 shrink-0" />
                          <span>{formatDate(report.lastUpdate)}</span>
                        </span>
                        <ArrowUpRight className="h-3.5 w-3.5 text-muted-foreground/50 group-hover/report:text-primary transition-colors" />
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>

            <div class="px-5 py-3 border-t border-border/60 bg-muted/30 flex items-center justify-between gap-2 text-xs text-muted-foreground">
              <span>
                {board.reports.length} {t("card.reports")}
              </span>
              {bestStatus && bestStatusClass && (
                <span
                  class={`inline-flex items-center rounded px-1.5 py-0.5 text-[11px] font-semibold leading-none ${bestStatusClass}`}
                >
                  {bestStatus}
                </span>
              )}
            </div>
          </Card>
        );
      })}
    </div>
  )
}
