---
import { Card, CardHeader, CardTitle, CardContent } from "../ui/card";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { statusClassMap } from "@/config/site";
import type { BoardSystemSummary } from "./types";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  boardId: string;
  systems?: BoardSystemSummary[];
}

const { boardId, systems = [] }: Props = Astro.props;

const formatDate = (value: Date | null) =>
  value ? value.toLocaleDateString(lang) : "-";
---

{
  systems.length === 0 ? (
    <div class="text-center py-12">
      <p class="text-xl text-muted-foreground">
        {t("no_results") ?? "No results found"}
      </p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {systems.map((system) => (
        <Card className="transition-transform duration-200 hover:bg-muted hover:shadow-lg hover:translate-y-[-0.25rem]">
          <CardHeader>
            <CardTitle className="text-xl">{system.systemName}</CardTitle>
            <p class="text-sm text-muted-foreground">{system.systemId}</p>
          </CardHeader>
          <CardContent className="space-y-4">
            {system.reports.map((report) => (
              <a
                href={getRelativeLocaleUrl(
                  lang,
                  `reports/${boardId}-${report.systemDir}-${report.fileName}`,
                  { normalizeLocale: false },
                )}
                class="block rounded-lg border border-border p-4 transition-colors hover:bg-accent"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    {report.variant && (
                      <p class="text-sm text-muted-foreground">
                        {t("sys.variant")}: {report.variant}
                      </p>
                    )}
                    <p class="text-base font-medium text-foreground">
                      {report.version || "-"}
                    </p>
                  </div>
                  {(() => {
                    const statusClass =
                      statusClassMap[report.status] ?? statusClassMap.UNKNOWN;
                    return (
                      <span
                        class={`inline-block px-2 rounded-md font-medium text-xs ${statusClass}`}
                      >
                        {report.status}
                      </span>
                    );
                  })()}
                </div>
                <div class="mt-3 flex items-center justify-between text-sm text-muted-foreground">
                  <span>{t("sys.update")}</span>
                  <span>{formatDate(report.lastUpdate)}</span>
                </div>
              </a>
            ))}
          </CardContent>
        </Card>
      ))}
    </div>
  )
}
